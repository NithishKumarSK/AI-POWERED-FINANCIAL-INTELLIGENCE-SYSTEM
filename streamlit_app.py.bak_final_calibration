# CHARTS
# ══════════════════════════════════════════════════════════════════════════════
def render_charts(ai_ui: dict, bt_ui: dict) -> None:
    _sec("Section 6 · Charts")

    try:
        import plotly.graph_objects as go
    except ImportError:
        st.caption("Install plotly: pip install plotly")
        return

    c1, c2 = st.columns(2)

    # ── Chart 1: Predicted vs Actual equity curve ─────────────────────────
    with c1:
        trial_rows = bt_ui.get("trial_rows", []) or []
        cap        = float(bt_ui.get("initial_capital", 100_000))
        if trial_rows:
            dates   = [r.get("exit_date") or r.get("entry_date", str(i)) for i, r in enumerate(trial_rows)]
            cum_bt  = []
            total   = 0.0
            for r in trial_rows:
                total += float(r.get("profit_loss", 0))
                cum_bt.append(cap + total)

            pred_final = float(ai_ui.get("final_capital") or cap)
            n = len(cum_bt)
            cum_ai = [cap + (pred_final - cap) * i / max(1, n - 1) for i in range(n)]

            fig = go.Figure()
            fig.add_trace(go.Scatter(x=dates, y=cum_bt, mode="lines", name="Backtest Actual",
                                     line=dict(color="#059669", width=2)))
            fig.add_trace(go.Scatter(x=dates, y=cum_ai, mode="lines", name="AI Predicted",
                                     line=dict(color="#635BFF", width=2, dash="dash")))
            fig.update_layout(title="AI Predicted vs Backtest Actual Equity Curve",
                              height=280, margin=dict(l=10, r=10, t=36, b=10),
                              yaxis_title="Capital ($)", legend=dict(orientation="h"))
            st.plotly_chart(fig, use_container_width=True)
        else:
            st.caption("Equity curve: no trial data from backtest.")

    # ── Chart 2: Strategy factor score bar ───────────────────────────────
    with c2:
        factors = ai_ui.get("strategy_factor_scores", {})
        if factors:
            factor_keys = [
                "underlying_regime", "strategy_suitability", "delta_risk", "dte_risk",
                "entry_frequency", "benchmark_regime", "volatility_risk",
                "news_sentiment", "capital_exposure", "strategy_confidence",
            ]
            labels = [factors[k].get("factor", k)[:22] for k in factor_keys if k in factors]
            scores = [factors[k]["score"] for k in factor_keys if k in factors]
            colors = ["#059669" if s >= 65 else ("#F59E0B" if s >= 40 else "#DC2626") for s in scores]
            fig2 = go.Figure(go.Bar(x=labels, y=scores, marker_color=colors,
                                    text=scores, textposition="outside"))
            fig2.update_layout(title="Strategy Factor Intelligence Scores",
                               height=280, margin=dict(l=10, r=10, t=36, b=10),
                               yaxis=dict(range=[0, 115]), xaxis_tickangle=-35)
            st.plotly_chart(fig2, use_container_width=True)
        else:
            st.caption("Factor chart: no scores available.")

    # ── Chart 3: Rolling verification errors ─────────────────────────────
    records = load_strategy_accuracy_records()
    if len(records) >= 2:
        ret_errs = []
        labels   = []
        for i, r in enumerate(records[-10:]):
            cmp_ = r.get("comparison", {})
            err  = cmp_.get("return_error_pct")
            if err is not None:
                ret_errs.append(float(err))
                sym_  = r.get("strategy_input", {}).get("symbol", "")
                start = r.get("strategy_input", {}).get("start_date", "")[:7]
                labels.append(f"{sym_} {start}")
        if ret_errs:
            colors2 = ["#059669" if abs(e) < 5 else ("#F59E0B" if abs(e) < 15 else "#DC2626")
                       for e in ret_errs]
            fig3 = go.Figure(go.Bar(x=labels, y=ret_errs, marker_color=colors2,
                                    text=[f"{e:+.1f}%" for e in ret_errs], textposition="outside"))
            fig3.add_hline(y=0, line_color="#6B7280", line_dash="dash")
            fig3.update_layout(title="Return Prediction Error by Rolling Window (AI − Actual)",
                               height=250, margin=dict(l=10, r=10, t=36, b=10),
                               yaxis_title="Error (%)")
            st.plotly_chart(fig3, use_container_width=True)


