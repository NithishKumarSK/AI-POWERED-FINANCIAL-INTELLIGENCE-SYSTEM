def _hr():
    st.markdown("<hr class='af-hr'>", unsafe_allow_html=True)

def _sec(t: str):
    st.markdown(f'<div class="sec-head">{t}</div>', unsafe_allow_html=True)

def _fv(val, fmt: str = "", prefix: str = "", suffix: str = "") -> str:
    """Format value; return styled N/A if None — should not appear after validation."""
    if val is None:
        return '<span style="color:#94A3B8;font-style:italic">—</span>'
    try:
        if fmt: return f"<b>{prefix}{float(val):{fmt}}{suffix}</b>"
        return f"<b>{prefix}{val}{suffix}</b>"
    except Exception:
        return f"<b>{val}</b>"

def _dv_cls(d: str) -> str:
    return {"BUY": "mt-buy", "SELL": "mt-sell", "HOLD": "mt-hold",
            "BUY WITH CAUTION": "mt-buy", "AVOID": "mt-sell"}.get(d, "mt-rev")

def _dc_cls(d: str) -> str:
    m = {"BUY": "dc-buy", "SELL": "dc-sell", "HOLD": "dc-hold",
         "BUY WITH CAUTION": "dc-caution", "HOLD WITH WATCHLIST": "dc-partial",
         "PARTIAL POSITIVE": "dc-partial", "PARTIAL NEGATIVE": "dc-partial",
         "CONFLICT": "dc-sell", "MATCH": "dc-buy", "AVOID": "dc-avoid",
         "REVIEW": "dc-review"}
    return m.get(d, "dc-review")

def _score_bar(label: str, score: int, signal: str = "") -> str:
    pct = min(max(score, 0), 100)
    if pct >= 65:   cls = "sb-hi"
    elif pct >= 40: cls = "sb-md"
    else:           cls = "sb-lo"
    sub = f" · {signal}" if signal else ""
    return (f'<div class="sb-wrap">'
            f'<div class="sb-label"><span>{label}{sub}</span><span>{score}/100</span></div>'
            f'<div class="sb-track"><div class="sb-fill {cls}" style="width:{pct}%"></div></div>'
            f'</div>')

def _metric_table(rows: list) -> str:
    trs = "".join(
        f'<tr><td class="mt-lbl">{lbl}</td><td class="mt-val">{val}</td></tr>'
        for lbl, val in rows
    )
    return f'<table class="mt-tbl">{trs}</table>'

def _acc_card(lbl: str, val: str, sub: str = "") -> str:
    return (f'<div class="acc-card">'
            f'<div class="acc-lbl">{lbl}</div>'
            f'<div class="acc-val">{val}</div>'
            + (f'<div class="acc-sub">{sub}</div>' if sub else "")
            + '</div>')

def _delta_html(val: float, suffix: str = "") -> str:
    if val > 0:  cls = "delta-pos"; sym = "+"
    elif val < 0: cls = "delta-neg"; sym = ""
    else:          cls = "delta-neu"; sym = ""
    return f'<span class="{cls}">{sym}{val:.2f}{suffix}</span>'


