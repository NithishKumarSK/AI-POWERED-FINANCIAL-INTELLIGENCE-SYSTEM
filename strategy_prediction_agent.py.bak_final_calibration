# ── Required strategy fields ──────────────────────────────────────────────────
REQUIRED_FIELDS = [
    "symbol", "start_date", "end_date", "initial_capital",
    "benchmark", "direction", "side", "dte", "delta",
    "legs", "entry_frequency", "decision_horizon",
]


def build_strategy_input_hash(strategy_input: dict) -> str:
    """SHA-256 of canonical JSON. Both engines must show this same hash."""
    subset = {k: strategy_input[k] for k in sorted(REQUIRED_FIELDS) if k in strategy_input}
    return hashlib.sha256(json.dumps(subset, sort_keys=True).encode()).hexdigest()[:16]


def validate_strategy_input(si: dict) -> Tuple[bool, str]:
    for f in REQUIRED_FIELDS:
        if f not in si or si[f] is None or si[f] == "":
            return False, f"Missing required field: {f}"
    try:
        if int(si["delta"]) < 1 or int(si["delta"]) > 99:
            return False, f"delta must be 1-99, got {si['delta']}"
        if int(si["dte"]) < 1 or int(si["dte"]) > 365:
            return False, f"dte must be 1-365, got {si['dte']}"
        if float(si["initial_capital"]) <= 0:
            return False, f"initial_capital must be positive, got {si['initial_capital']}"
        if int(si["legs"]) < 1 or int(si["legs"]) > 10:
            return False, f"legs must be 1-10, got {si['legs']}"
        if si["direction"] not in ("short", "long"):
            return False, f"direction must be 'short' or 'long', got {si['direction']}"
        if si["side"] not in ("put", "call"):
            return False, f"side must be 'put' or 'call', got {si['side']}"
    except (TypeError, ValueError) as e:
        return False, f"Invalid numeric field: {e}"
    return True, ""


# ── Date utilities ────────────────────────────────────────────────────────────
def _parse_date(s: str) -> datetime:
    return datetime.strptime(str(s).strip(), "%Y-%m-%d")


def _get_years(start_date: str, end_date: str) -> float:
    return max(0.01, (_parse_date(end_date) - _parse_date(start_date)).days / 365.25)


def _get_trade_count(start_date: str, end_date: str, entry_frequency: str) -> int:
    delta_days = (_parse_date(end_date) - _parse_date(start_date)).days
    freq = str(entry_frequency).lower()
    if "month" in freq:
        return max(1, round(delta_days / 30))
    elif "week" in freq:
        return max(1, round(delta_days / 7))
    elif "day" in freq:
        return max(1, round(delta_days * 252 / 365))
    return max(1, round(delta_days / 30))  # default monthly


# ── RapidAPI context ──────────────────────────────────────────────────────────
def _get_rapidapi_context(symbol: str) -> dict:
    """
    Fetch live market context from RapidAPI trading-view.p.rapidapi.com.
    Returns structured dict. Never raises — returns empty context on any failure.
    """
    base_ctx: dict = {
        "gainers": [], "losers": [], "active": [],
        "news": [], "movers_available": False, "news_available": False,
        "endpoint_results": {}
    }
    try:
        from rapidapi_client import rapidapi_get

        def _parse_symbols(result: dict) -> list:
            if result.get("status") != "SUCCESS":
                return []
            data = result.get("data", {})
            if isinstance(data, dict):
                symbols = data.get("symbols", [])
                return [
                    s.get("s", "").split(":")[-1]
                    for s in symbols if isinstance(s, dict) and s.get("s")
                ]
            return []

        gainers_r = rapidapi_get("/market/get-movers",
                                  params={"exchange": "US", "name": "percent_change_gainers", "locale": "en"},
                                  timeout=20)
        losers_r  = rapidapi_get("/market/get-movers",
                                  params={"exchange": "US", "name": "percent_change_losers", "locale": "en"},
                                  timeout=20)
        active_r  = rapidapi_get("/market/get-movers",
                                  params={"exchange": "US", "name": "volume_gainers", "locale": "en"},
                                  timeout=20)
        news_r    = rapidapi_get("/news/list", params={"lang": "en"}, timeout=20)

        gainers = _parse_symbols(gainers_r)
        losers  = _parse_symbols(losers_r)
        active  = _parse_symbols(active_r)
        news    = news_r.get("data", []) if news_r.get("status") == "SUCCESS" else []
        news    = news if isinstance(news, list) else []

        movers_ok = (gainers_r.get("status") == "SUCCESS" or
                     losers_r.get("status") == "SUCCESS" or
                     active_r.get("status") == "SUCCESS")

        base_ctx.update({
            "gainers": gainers,
            "losers": losers,
            "active": active,
            "news": news[:50],
            "movers_available": movers_ok,
            "news_available": news_r.get("status") == "SUCCESS",
            "endpoint_results": {
                "/market/get-movers (gainers)": gainers_r.get("status"),
                "/market/get-movers (losers)":  losers_r.get("status"),
                "/market/get-movers (active)":  active_r.get("status"),
                "/news/list":                   news_r.get("status"),
            }
        })
    except Exception as exc:
        base_ctx["error"] = str(exc)
    return base_ctx


# ── 10 strategy factor scores ─────────────────────────────────────────────────
def _compute_factor_scores(si: dict, ctx: dict) -> dict:
    """
    Compute 10 strategy-specific factor scores (0-100).
    Every score depends on strategy inputs or RapidAPI context — no generic stock analysis.
    """
    symbol     = str(si["symbol"]).upper()
    direction  = str(si["direction"]).lower()
    side       = str(si["side"]).lower()
    delta      = int(si["delta"])
    dte        = int(si["dte"])
    legs       = int(si["legs"])
    freq       = str(si["entry_frequency"]).lower()
    capital    = float(si["initial_capital"])
    start_date = si["start_date"]
    end_date   = si["end_date"]

    gainers = ctx.get("gainers", [])
    losers  = ctx.get("losers",  [])
    active  = ctx.get("active",  [])
    news    = ctx.get("news",    [])
    trade_count = _get_trade_count(start_date, end_date, freq)
    years = _get_years(start_date, end_date)

    # ── 1. Underlying Regime Score ────────────────────────────────────────
    if symbol in gainers:
        u_sc = 74; u_sig = "Bullish"; u_src = "RapidAPI movers"
        u_exp = f"{symbol} appears in RapidAPI top gainers — bullish regime"
    elif symbol in losers:
        u_sc = 30; u_sig = "Bearish"; u_src = "RapidAPI movers"
        u_exp = f"{symbol} appears in RapidAPI top losers — bearish regime"
    elif symbol in active:
        u_sc = 58; u_sig = "Active/Neutral"; u_src = "RapidAPI movers"
        u_exp = f"{symbol} in high-volume active list — elevated activity"
    else:
        u_sc = 55; u_sig = "Neutral"; u_src = "RapidAPI movers (not listed)"
        u_exp = f"{symbol} not in today's movers — baseline neutral regime assumed"

    # ── 2. Options Strategy Suitability Score ─────────────────────────────
    if direction == "short" and side == "put":
        if delta <= 20:
            s_sc = 80; s_sig = "Highly Supportive"
        elif delta <= 30:
            s_sc = 72; s_sig = "Supportive"
        elif delta <= 40:
            s_sc = 60; s_sig = "Moderate"
        else:
            s_sc = 44; s_sig = "Elevated Risk"
        s_exp = f"Short put Δ{delta}: high-probability premium-selling; defined-risk if spread"
    elif direction == "short" and side == "call":
        if delta <= 30:
            s_sc = 68; s_sig = "Supportive"
        else:
            s_sc = 52; s_sig = "Moderate"
        s_exp = f"Short call Δ{delta}: bearish/neutral premium-selling strategy"
    elif direction == "long":
        s_sc = 52; s_sig = "Neutral (Directional)"
        s_exp = f"Long {side} Δ{delta}: requires directional conviction — lower win probability"
    else:
        s_sc = 50; s_sig = "Neutral"
        s_exp = "Strategy type assessment baseline"
    s_src = "StrategyInput"

    # ── 3. Delta Risk Score ───────────────────────────────────────────────
    if delta <= 15:
        d_sc = 85; d_sig = "Very Low Risk (Deep OTM)"
    elif delta <= 25:
        d_sc = 75; d_sig = "Low Risk (OTM)"
    elif delta <= 35:
        d_sc = 65; d_sig = "Moderate Risk"
    elif delta <= 45:
        d_sc = 50; d_sig = "Elevated Risk (Near ATM)"
    else:
        d_sc = 35; d_sig = "High Risk (ATM/ITM)"
    if legs >= 2:
        d_sc = min(100, d_sc + 6)
        d_sig += " (Spread caps loss)"
    d_src = "StrategyInput"
    d_exp = f"Δ{delta}, {legs} leg(s): P(OTM at exp) ≈ {100-delta}% — {'spread limits downside' if legs >= 2 else 'naked exposure'}"

    # ── 4. DTE Risk Score ─────────────────────────────────────────────────
    if dte <= 14:
        dte_sc = 55; dte_sig = "High Gamma (Very Short)"
    elif dte <= 21:
        dte_sc = 62; dte_sig = "Short DTE — faster decay"
    elif dte <= 50:
        dte_sc = 76; dte_sig = "Standard (45-50 DTE ideal)"
    elif dte <= 90:
        dte_sc = 65; dte_sig = "Medium Duration"
    else:
        dte_sc = 52; dte_sig = "Long Duration — slower theta"
    dte_src = "StrategyInput"
    dte_exp = f"DTE {dte}: {'within' if 40 <= dte <= 60 else 'outside'} the 45-50 DTE premium-selling sweet spot"

    # ── 5. Entry Frequency Score ──────────────────────────────────────────
    if "month" in freq:
        f_sc = 72; f_sig = "Balanced — 1x/month"
    elif "week" in freq:
        f_sc = 60; f_sig = "Higher Frequency"
    elif "day" in freq:
        f_sc = 44; f_sig = "Very High Frequency"
    else:
        f_sc = 62; f_sig = "Standard"
    f_src = "StrategyInput"
    f_exp = f"{freq.title()} entries: ~{trade_count} trades over {years:.1f}yr period"

    # ── 6. Benchmark Regime Score ─────────────────────────────────────────
    g_ct = len(gainers)
    l_ct = len(losers)
    if g_ct > l_ct * 1.2:
        b_sc = 66; b_sig = "Broad Market Bullish"
    elif l_ct > g_ct * 1.2:
        b_sc = 38; b_sig = "Broad Market Bearish"
    else:
        b_sc = 54; b_sig = "Mixed Market"
    b_src = "RapidAPI movers" if ctx.get("movers_available") else "Default (API unavailable)"
    b_exp = f"RapidAPI today: {g_ct} gainers vs {l_ct} losers — {si.get('benchmark','SPY')} regime proxy"

    # ── 7. Volatility / Risk Score ────────────────────────────────────────
    if direction == "short":
        v_sc = 63; v_sig = "Favourable (IV > RV premium)"
        v_exp = f"Short {side}: IV historically exceeds realized vol → edge for premium sellers"
    else:
        v_sc = 50; v_sig = "Neutral (directional vol exposure)"
        v_exp = f"Long {side}: vol must move in direction — less forgiving"
    v_src = "Derived (strategy direction)"

    # ── 8. News / Sentiment Score ─────────────────────────────────────────
    bull_kw = ["beat","beats","gain","gains","upgrade","upgraded","rises","rise",
               "strong","record","rally","growth","bullish","outperform",
               "positive","breakout","jumped","jumps","soars","buying opportunity"]
    bear_kw = ["miss","misses","fall","falls","downgrade","downgraded","cuts",
               "cut","loss","losses","concern","probe","lawsuit","decline",
               "declines","bearish","sell","weak","warning","drop","drops","layoffs"]

    bull_ct = bear_ct = sym_ct = 0
    for art in news[:30]:
        title = (art.get("title", "") or "").lower()
        desc  = (art.get("description", "") or "").lower()
        body  = title + " " + desc
        related = art.get("relatedSymbols", []) or []
        if isinstance(related, list) and any(symbol in str(r.get("symbol","")).upper() for r in related):
            sym_ct += 1
        for kw in bull_kw:
            if kw in body:
                bull_ct += 1
                break
        for kw in bear_kw:
            if kw in body:
                bear_ct += 1
                break

    if bull_ct > bear_ct:
        sent_sc = min(80, 55 + (bull_ct - bear_ct) * 3)
        sent_sig = "Bullish"
    elif bear_ct > bull_ct:
        sent_sc = max(22, 50 - (bear_ct - bull_ct) * 3)
        sent_sig = "Bearish"
    elif len(news) > 0:
        sent_sc = 50; sent_sig = "Neutral"
    else:
        sent_sc = 50; sent_sig = "No News Data"
    sent_src = "RapidAPI news" if ctx.get("news_available") else "Default (news unavailable)"
    sent_exp = f"{bull_ct} bullish vs {bear_ct} bearish headlines; {sym_ct} articles mention {symbol}"

    # ── 9. Capital Exposure Score ─────────────────────────────────────────
    if legs >= 2:
        cap_sc = 70; cap_sig = "Defined Risk (Spread)"
    else:
        cap_sc = 46; cap_sig = "Undefined Risk (Naked)"
    if capital >= 100_000:
        cap_sc = min(100, cap_sc + 5)
    elif capital < 10_000:
        cap_sc = max(0, cap_sc - 12)
    cap_src = "StrategyInput"
    cap_exp = f"${capital:,.0f} capital, {legs}-leg {'spread → capped loss' if legs >= 2 else 'naked → unlimited loss risk'}"

    # ── 10. Strategy Confidence Score ─────────────────────────────────────
    factor_list = [u_sc, s_sc, d_sc, dte_sc, f_sc, b_sc, v_sc, sent_sc, cap_sc]
    avg = sum(factor_list) / len(factor_list)
    variance = sum((s - avg) ** 2 for s in factor_list) / len(factor_list)
    std_dev = variance ** 0.5
    data_bonus = 8 if ctx.get("movers_available") else 0
    news_bonus = 5 if ctx.get("news_available") else 0
    trade_bonus = min(10, trade_count * 0.2)
    conf_sc = min(100, max(20, round(avg - std_dev * 0.2 + data_bonus + news_bonus + trade_bonus)))
    conf_sig = "High" if conf_sc >= 70 else ("Moderate" if conf_sc >= 50 else "Low")
    conf_src = "Derived (factor agreement + data completeness)"
    conf_exp = (f"{len(factor_list)}/9 input factors; avg={avg:.0f}/100; "
                f"factor spread std={std_dev:.1f}; "
                f"data completeness: movers={'✓' if ctx.get('movers_available') else '✗'} "
                f"news={'✓' if ctx.get('news_available') else '✗'}")

    def _mk(factor_name, sc, sig, src, exp):
        return {"score": sc, "signal": sig, "source": src,
                "factor": factor_name, "explanation": exp}

    return {
        "underlying_regime":     _mk("Underlying Regime Score",            u_sc,    u_sig,    u_src,    u_exp),
        "strategy_suitability":  _mk("Options Strategy Suitability Score", s_sc,    s_sig,    s_src,    s_exp),
        "delta_risk":            _mk("Delta Risk Score",                    d_sc,    d_sig,    d_src,    d_exp),
        "dte_risk":              _mk("DTE Risk Score",                      dte_sc,  dte_sig,  dte_src,  dte_exp),
        "entry_frequency":       _mk("Entry Frequency Score",               f_sc,    f_sig,    f_src,    f_exp),
        "benchmark_regime":      _mk("Benchmark Regime Score",              b_sc,    b_sig,    b_src,    b_exp),
        "volatility_risk":       _mk("Volatility / Risk Score",             v_sc,    v_sig,    v_src,    v_exp),
        "news_sentiment":        _mk("News / Sentiment Score",              sent_sc, sent_sig, sent_src, sent_exp),
        "capital_exposure":      _mk("Capital Exposure Score",              cap_sc,  cap_sig,  cap_src,  cap_exp),
        "strategy_confidence":   _mk("Strategy Confidence Score",           conf_sc, conf_sig, conf_src, conf_exp),
    }


# ── Deterministic strategy projection ────────────────────────────────────────
def _deterministic_projection(si: dict, factors: dict) -> dict:
    """
    Compute all prediction metrics using options strategy math + factor scores.
    Every number is documented. No yfinance. No backtest result.
    """
    direction  = str(si["direction"]).lower()
    side       = str(si["side"]).lower()
    delta      = int(si["delta"])
    dte        = int(si["dte"])
    legs       = int(si["legs"])
    freq       = str(si["entry_frequency"]).lower()
    capital    = float(si["initial_capital"])
    start_date = si["start_date"]
    end_date   = si["end_date"]

    trade_count = _get_trade_count(start_date, end_date, freq)
    years       = _get_years(start_date, end_date)

    # ── Win Rate ──────────────────────────────────────────────────────────
    # Base: P(option expires OTM) ≈ (100 - delta)% for short, delta% for long
    base_wr = (100 - delta) if direction == "short" else delta
    # Regime adjustment from RapidAPI context (+/- up to 12%)
    regime_avg = (factors["underlying_regime"]["score"] + factors["benchmark_regime"]["score"]) / 2
    regime_adj = (regime_avg - 50) * 0.24
    # Sentiment adjustment (+/- up to 5%)
    sent_adj = (factors["news_sentiment"]["score"] - 50) * 0.10
    # IV premium edge: short options benefit from IV > realized vol
    iv_edge = 3.0 if direction == "short" else -3.0
    win_rate_pct = max(25.0, min(92.0, base_wr + regime_adj + sent_adj + iv_edge))
    win_rate     = win_rate_pct / 100

    # ── Per-Trade Premium Estimation ─────────────────────────────────────
    # Simplified Black-Scholes: premium ≈ delta_frac^0.8 * IV * sqrt(T) * scaling
    # delta_frac = delta/100, T = dte/365, assumed_iv = 0.27 (typical large-cap)
    assumed_iv     = 0.27
    stock_pct_prem = (delta / 100) ** 0.8 * assumed_iv * (dte / 365) ** 0.5 * 0.90
    # Position allocation: spread uses 20%, naked uses 10%
    pos_alloc       = 0.20 if legs >= 2 else 0.10
    # Premium per winning trade as % of total portfolio
    prem_pct        = stock_pct_prem * pos_alloc * 100
    # Max loss per losing trade as % of portfolio
    # Spread (2-leg): typical 1:2 credit:risk → loss = 2x credit
    # Naked: larger tail risk → loss = 4x credit
    loss_mult       = 2.0 if legs >= 2 else 4.0
    max_loss_pct    = prem_pct * loss_mult

    # ── Expected Value per Trade ──────────────────────────────────────────
    ev_pct = win_rate * prem_pct - (1 - win_rate) * max_loss_pct

    # ── Total Return ──────────────────────────────────────────────────────
    raw_return = ev_pct * trade_count
    # Market regime scaling: bullish market amplifies positive returns
    mkt_scale = max(0.40, min(3.0, regime_avg / 50))
    total_ret  = raw_return * mkt_scale
    total_ret  = max(-80.0, min(300.0, total_ret))

    total_pl       = capital * total_ret / 100
    final_capital  = capital + total_pl

    # ── CAGR ──────────────────────────────────────────────────────────────
    if years > 0 and final_capital > 0 and capital > 0:
        cagr = ((final_capital / capital) ** (1.0 / years) - 1.0) * 100
    else:
        cagr = 0.0
    cagr = max(-99.0, min(200.0, cagr))

    # ── Annualised Volatility ─────────────────────────────────────────────
    # Short spread strategies: lower vol than underlying (15-30% range)
    # Base volatility by leg type
    base_vol    = 14 if legs >= 2 else 22
    risk_factor = max(0.0, (100 - factors["volatility_risk"]["score"]) / 100)
    volatility  = max(5.0, min(55.0, base_vol + risk_factor * 18.0))

    # ── Sharpe & Sortino ──────────────────────────────────────────────────
    rfr = 4.5  # risk-free rate %
    sharpe  = round((cagr - rfr) / volatility, 2) if volatility > 0 else 0.0
    # Sortino: downside std ≈ 0.65x total std for short-premium strategies
    downside_vol = volatility * 0.65
    sortino = round((cagr - rfr) / downside_vol, 2) if downside_vol > 0 else 0.0

    # ── Max Drawdown ──────────────────────────────────────────────────────
    # Estimate max consecutive losing streak
    p_loss = 1 - win_rate
    if p_loss > 0 and trade_count > 1:
        max_streak = math.ceil(math.log(trade_count + 1) / max(0.0001, math.log(1 / p_loss + 1e-9)))
    else:
        max_streak = 1
    max_drawdown = max(2.0, min(60.0, max_streak * max_loss_pct))

    # ── Max Profit / Max Loss (dollar) ────────────────────────────────────
    max_profit_usd = round(prem_pct / 100 * capital, 2)
    max_loss_usd   = -round(max_loss_pct / 100 * capital, 2)

    # ── Beta ──────────────────────────────────────────────────────────────
    # Short put: positive correlation to underlying (delta-equivalent exposure)
    # Short call: negative. Long options: same sign as underlying.
    if direction == "short" and side == "put":
        beta_sign = 1
    elif direction == "short" and side == "call":
        beta_sign = -1
    else:
        beta_sign = 1
    beta = round((delta / 100) * min(legs, 2) * 0.5 * beta_sign, 3)

    # ── Alpha ─────────────────────────────────────────────────────────────
    # Excess return vs benchmark (SPY ≈ 12% ann. as long-run average)
    benchmark_total = 12.0 * years
    alpha = round(total_ret - benchmark_total, 2)

    # ── Risk Score ────────────────────────────────────────────────────────
    dd_comp   = min(1.0, max_drawdown / 50)
    vol_comp  = min(1.0, volatility   / 45)
    loss_comp = 1 - win_rate
    risk_score = max(0, min(100, round((dd_comp * 40 + vol_comp * 30 + loss_comp * 30) * 100)))

    # ── Confidence Score ──────────────────────────────────────────────────
    conf_score = min(100, max(25, factors["strategy_confidence"]["score"]))

    # ── Decision ──────────────────────────────────────────────────────────
    if total_ret > 0 and win_rate_pct >= 55 and risk_score <= 70:
        decision = "BUY"
    elif total_ret < -5 or risk_score >= 85:
        decision = "SELL"
    elif total_ret > 0:
        decision = "HOLD"
    else:
        decision = "HOLD"

    return {
        "decision": decision,
        "predicted_initial_capital":    capital,
        "predicted_final_capital":      round(final_capital, 2),
        "predicted_total_pl":           round(total_pl, 2),
        "predicted_total_return_pct":   round(total_ret, 2),
        "predicted_cagr":               round(cagr, 2),
        "predicted_sharpe":             sharpe,
        "predicted_sortino":            sortino,
        "predicted_max_drawdown":       round(max_drawdown, 2),
        "predicted_win_rate":           round(win_rate_pct, 1),
        "predicted_trade_count":        trade_count,
        "predicted_alpha":              alpha,
        "predicted_beta":               beta,
        "predicted_volatility":         round(volatility, 1),
        "predicted_risk_score":         risk_score,
        "predicted_confidence_score":   conf_score,
        "predicted_max_profit":         max_profit_usd,
        "predicted_max_loss":           max_loss_usd,
    }


# ── Gemini explanation (optional) ─────────────────────────────────────────────
def _gemini_explanation(si: dict, factors: dict, proj: dict) -> str:
    """Generate a one-paragraph Gemini explanation. Returns empty string on failure."""
    try:
        import google.generativeai as genai
        api_key = os.getenv("GOOGLE_API_KEY", "") or os.getenv("GEMINI_API_KEY", "")
        if not api_key:
            return ""
        genai.configure(api_key=api_key)
        model_name = os.getenv("AGENT_MODEL", "gemini-2.5-flash")
        model = genai.GenerativeModel(model_name)

        prompt = (
            f"You are an options strategy analyst.\n"
            f"Strategy: {si['direction']} {si['side']} on {si['symbol']}, "
            f"delta={si['delta']}, DTE={si['dte']}, legs={si['legs']}, "
            f"entry={si['entry_frequency']}, period={si['start_date']} to {si['end_date']}, "
            f"capital=${si['initial_capital']:,.0f}.\n\n"
            f"AI prediction: decision={proj['decision']}, "
            f"predicted return={proj['predicted_total_return_pct']:.1f}%, "
            f"win rate={proj['predicted_win_rate']:.1f}%, "
            f"trade count={proj['predicted_trade_count']}, "
            f"risk score={proj['predicted_risk_score']}/100.\n\n"
            f"Key factor scores: "
            f"underlying_regime={factors['underlying_regime']['score']}/100 ({factors['underlying_regime']['signal']}), "
            f"strategy_suitability={factors['strategy_suitability']['score']}/100 ({factors['strategy_suitability']['signal']}), "
            f"delta_risk={factors['delta_risk']['score']}/100, "
            f"news_sentiment={factors['news_sentiment']['score']}/100 ({factors['news_sentiment']['signal']}).\n\n"
            f"Write exactly ONE concise paragraph (3-4 sentences) explaining why the strategy "
            f"prediction is {proj['decision']}. Focus on the options strategy mechanics, "
            f"not general stock analysis. Do not repeat numbers verbatim."
        )
        resp = model.generate_content(prompt)
        return resp.text.strip()[:1500]
    except Exception:
        return ""


# ── Main entry point ──────────────────────────────────────────────────────────
def run_ai_strategy_prediction(strategy_input: dict) -> dict:
    """
    Full AI strategy prediction pipeline.

    Input: StrategyInput dict (all REQUIRED_FIELDS present)
    Output: StrategyPredictionOutput with all metrics computed.

    Does NOT receive or use backtest results — completely independent.
    """
    # Guard: no backtest leakage
    assert "backtest" not in str(strategy_input).lower() or "backtest" in str(strategy_input.get("benchmark","")).lower(), \
        "Strategy input must not contain backtest results"

    valid, err = validate_strategy_input(strategy_input)
    if not valid:
        return {
            "status":  "ERROR",
            "error":   err,
            "source":  "strategy_prediction_agent",
            "decision": "REVIEW",
        }

    input_hash = build_strategy_input_hash(strategy_input)

    # 1. Get RapidAPI market context
    ctx = _get_rapidapi_context(strategy_input["symbol"])

    # 2. Compute 10 factor scores
    factors = _compute_factor_scores(strategy_input, ctx)

    # 3. Deterministic projection
    proj = _deterministic_projection(strategy_input, factors)

    # 4. Optional Gemini explanation
    explanation = _gemini_explanation(strategy_input, factors, proj)
    if not explanation:
        d = proj["decision"]
        wr = proj["predicted_win_rate"]
        ret = proj["predicted_total_return_pct"]
        explanation = (
            f"AI strategy prediction for {strategy_input['direction']} {strategy_input['side']} "
            f"Δ{strategy_input['delta']} on {strategy_input['symbol']}: decision={d}. "
            f"Estimated win rate {wr:.1f}% (base {100 - strategy_input['delta']}% OTM probability "
            f"plus market regime and IV-premium adjustments). "
            f"Predicted total return {ret:.1f}% over {_get_years(strategy_input['start_date'], strategy_input['end_date']):.1f}yr "
            f"across {proj['predicted_trade_count']} {strategy_input['entry_frequency']} entries. "
            f"Risk score {proj['predicted_risk_score']}/100 — {'defined-risk spread' if strategy_input['legs'] >= 2 else 'naked exposure'}."
        )

    return {
        "status":                      "SUCCESS",
        "source":                      "strategy_prediction_agent",
        "strategy_input_hash":         input_hash,
        "prediction_scope":            "same_options_strategy",
        **proj,
        "strategy_factor_scores":      factors,
        "rapidapi_context_summary":    {
            "movers_available": ctx.get("movers_available"),
            "news_available":   ctx.get("news_available"),
            "gainers_count":    len(ctx.get("gainers", [])),
            "losers_count":     len(ctx.get("losers",  [])),
            "news_count":       len(ctx.get("news",    [])),
            "endpoint_results": ctx.get("endpoint_results", {}),
        },
        "explanation":                 explanation,
    }
