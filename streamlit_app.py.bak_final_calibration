def render_config_panel() -> dict:
    with st.expander("Strategy Input Configuration", expanded=True):
        c1, c2, c3, c4 = st.columns(4)
        with c1: sym     = st.text_input("Symbol",           value="AAPL",       key="sym")
        with c2: start   = st.text_input("Start Date",       value="2021-06-25", key="start")
        with c3: end     = st.text_input("End Date",         value="2025-01-24", key="end")
        with c4: capital = st.number_input("Initial Capital ($)", value=100_000,
                                           min_value=1_000, step=10_000, format="%d", key="cap")

        d1, d2, d3, d4 = st.columns(4)
        with d1: horizon   = st.number_input("Decision Horizon (days)", value=30, min_value=1, max_value=365, key="hor")
        with d2: benchmark = st.text_input("Benchmark", value="SPY", key="bench")
        with d3: pass
        with d4: pass

        st.markdown("**Options Strategy Parameters**")
        e1, e2, e3, e4, e5, e6 = st.columns(6)
        with e1: direction = st.selectbox("Direction", ["short", "long"],         key="dir")
        with e2: side      = st.selectbox("Side",      ["put",   "call"],         key="side")
        with e3: dte       = st.number_input("DTE",   value=50, min_value=1, max_value=365, key="dte")
        with e4: delta     = st.number_input("Delta", value=30, min_value=1, max_value=99,  key="dlt")
        with e5: num_legs  = st.selectbox("Legs", [1, 2, 3, 4], index=1,          key="legs")
        with e6: frequency = st.selectbox("Entry Frequency",
                                          ["monthly", "weekly", "every day"],      key="freq")

    return {
        "symbol":           (sym or "AAPL").strip().upper(),
        "start_date":       start,
        "end_date":         end,
        "initial_capital":  float(capital),
        "decision_horizon": int(horizon),
        "benchmark":        (benchmark or "SPY").strip().upper(),
        "direction":        direction,
        "side":             side,
        "dte":              int(dte),
        "delta":            int(delta),
        "legs":             int(num_legs),
        "entry_frequency":  frequency,
    }


