                    + _acc_card("Macro Precision",      f"{m['macro_precision']*100:.1f}%", "macro avg")
                    + _acc_card("Macro Recall",         f"{m['macro_recall']*100:.1f}%",    "macro avg")
                    + '</div>')
            st.markdown(html, unsafe_allow_html=True)

            html2 = ('<div class="acc-grid">'
                     + _acc_card("Macro F1",           f"{m['macro_f1']*100:.1f}%",    "macro avg")
                     + _acc_card("Avg Return Error",   f"{m['avg_return_abs_error']:.1f}%", "abs error")
                     + _acc_card("Avg P&L Error",      f"${m['avg_pl_abs_error']:,.0f}", "abs error")
                     + _acc_card("Records Count",      str(m["n_records"]), "strategy verifications")
                     + '</div>')
            st.markdown(html2, unsafe_allow_html=True)
            st.caption(f"Accuracy from {m['n_records']} strategy_backtest_verification records — "
                       f"AI strategy prediction vs tastytrade actual outcomes.")

            # Per-class table
            pc = m.get("per_class", {})
            if pc:
                st.dataframe([{
                    "Decision":  k,
                    "Precision": f"{v['precision']*100:.1f}%",
                    "Recall":    f"{v['recall']*100:.1f}%",
                    "F1":        f"{v['f1']*100:.1f}%",
                    "Support":   v["support"],
                } for k, v in pc.items()], use_container_width=True, hide_index=True)

            # Confusion matrix
            _render_cm(m)

    else:
        html = ('<div class="acc-grid">'
                + _acc_card("Decision Accuracy", "Needs data", "")
                + _acc_card("Directional Acc",   "Needs data", "")
                + _acc_card("Macro F1",           "Needs data", "")
                + _acc_card("Records Count",      str(len(records)), "strategy verifications")
                + '</div>')
        st.markdown(html, unsafe_allow_html=True)
        st.info(f"Strategy accuracy requires ≥ 2 verification records. "
                f"Current: {len(records)} record(s). Run rolling verification below to generate real records.")

    # Rolling verification button
    st.markdown("")
    c1, c2 = st.columns([1, 3])
    with c1:
        if st.button("RUN STRATEGY ROLLING VERIFICATION", type="primary", key="roll_verify"):
            with st.spinner("Creating rolling verification windows…"):
                n = run_strategy_rolling_verification(
                    si, n_windows=5,
                    backtest_fn=run_tastytrade_strategy_backtest)
            if n >= 2:
                st.success(f"Created {n} strategy verification records (AI prediction vs tastytrade backtest).")
                st.rerun()
            elif n == 1:
                st.warning("Created 1 record — need ≥ 2. Try again or widen date range.")
                st.rerun()
            else:
                st.error("Could not create records — tastytrade backtest failed for all windows. Check credentials.")
    with c2:
        st.caption("Creates 5 rolling 12-month windows within your selected date range. "
                   "For each window: runs AI prediction first (independent), "
                   "then tastytrade backtest, then saves comparison record.")


def _render_cm(m: dict) -> None:
    lbls = m.get("cm_labels", [])
    mat  = m.get("cm_matrix", [])
    if not lbls or not mat:
        return
    try:
        import plotly.graph_objects as go
        fig = go.Figure(go.Heatmap(z=mat, x=lbls, y=lbls, colorscale="Blues",
                                   text=mat, texttemplate="%{text}", showscale=True))
        fig.update_layout(title="Confusion Matrix — AI Predicted vs Backtest Actual",
                          height=280, margin=dict(l=10, r=10, t=36, b=10),
                          xaxis_title="AI Predicted", yaxis_title="Backtest Actual")
        st.plotly_chart(fig, use_container_width=True)
    except Exception:
        pass


