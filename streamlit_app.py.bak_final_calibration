# MAIN
# ══════════════════════════════════════════════════════════════════════════════
def main() -> None:
    env = _env_status()
    render_header(env)
    si  = render_config_panel()

    st.button(
        "RUN STRATEGY PREDICTION + BACKTEST VERIFICATION",
        type="primary", use_container_width=True, key="run_btn",
    )

    if st.session_state.get("run_btn"):
        st.session_state["has_run"] = True
        input_hash = build_strategy_input_hash(si)

        # Step 1: Validate StrategyInput
        valid, err = validate_strategy_input(si)
        if not valid:
            st.error(f"Run blocked: invalid strategy input — {err}")
            st.stop()

        # Step 2: AI prediction — INDEPENDENT of backtest (no backtest data here)
        with st.spinner(f"Running AI strategy prediction for {si['symbol']}…"):
            ai_raw = run_ai_strategy_prediction(si)

        # Step 3: Normalize AI output → generic UI field names
        ai_ui = normalize_ai_prediction_for_ui(ai_raw, si)

        # Step 4: Blocking validation on normalized AI output
        if ai_ui.get("status") == "SUCCESS":
            ok, err = validate_no_missing_output(ai_ui)
            if not ok:
                st.error(f"AI prediction output incomplete — {err}")
                st.stop()

        st.session_state["ai_raw"]     = ai_raw
        st.session_state["ai_ui"]      = ai_ui
        st.session_state["input_hash"] = input_hash
        st.session_state["last_si"]    = si

        # Step 5: tastytrade backtest (ground-truth verifier)
        with st.spinner(f"Running tastytrade backtest for {si['symbol']}…"):
            bt_raw = run_tastytrade_strategy_backtest(si)

        # Step 6: Normalize backtest output → same generic UI field names
        bt_ui = normalize_backtest_for_ui(bt_raw, si)
        st.session_state["bt_raw"] = bt_raw
        st.session_state["bt_ui"]  = bt_ui

        # Step 7: Save evaluation record (uses raw outputs for accuracy tracking)
        if ai_raw.get("status") == "SUCCESS" and bt_raw.get("passed_validation"):
            rec = build_evaluation_record(si, input_hash, ai_raw, bt_raw)
            save_strategy_evaluation_record(rec)

    if not st.session_state.get("has_run"):
        _hr()
        st.info(
            f"Configure strategy inputs above, then click **RUN STRATEGY PREDICTION + BACKTEST VERIFICATION**.  \n"
            f"Default: {si['symbol']} · {si['start_date']} → {si['end_date']} · "
            f"${si['initial_capital']:,.0f} · {si['direction']} {si['side']} "
            f"DTE={si['dte']} Δ={si['delta']} legs={si['legs']} {si['entry_frequency']}"
        )
        return

    ai_ui      = st.session_state.get("ai_ui",      {})
    bt_ui      = st.session_state.get("bt_ui",       {})
    si_display = st.session_state.get("last_si",     si)
    input_hash = st.session_state.get("input_hash",  build_strategy_input_hash(si))

    # compare_prediction_vs_backtest works on the raw outputs (predicted_* keys)
    ai_raw = st.session_state.get("ai_raw", {})
    bt_raw = st.session_state.get("bt_raw", {})
    cmp = compare_prediction_vs_backtest(ai_raw, bt_raw)

    _hr()
    render_strategy_inputs_section(si_display, input_hash)

    _hr()
    render_comparison_columns(ai_ui, bt_ui, cmp)

    _hr()
    render_factor_scores(ai_ui)

    _hr()
    render_final_decision_board(cmp)

    _hr()
    render_accuracy_section(si_display)

    _hr()
    render_charts(ai_ui, bt_ui)

    _hr()
    render_debug_expanders(si_display, input_hash, ai_ui, bt_ui)


if __name__ == "__main__":
    main()
