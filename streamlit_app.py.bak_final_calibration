_FORBIDDEN_VALUES = {"Not available", "Not estimated", "Unavailable", "N/A", ""}

_UI_REQUIRED_FIELDS = [
    "decision", "initial_capital", "final_capital", "total_pl", "total_return_pct",
    "cagr", "sharpe", "sortino", "max_drawdown", "win_rate", "trade_count",
    "alpha", "beta", "volatility", "risk_score", "confidence_score",
    "max_profit", "max_loss",
]


def validate_no_missing_output(output: dict) -> Tuple[bool, str]:
    """
    Fail if any required UI field is None or a forbidden placeholder.
    Reports ALL missing fields at once so the user sees everything in one error.
    """
    missing = []
    for f in _UI_REQUIRED_FIELDS:
        v = output.get(f)
        if v is None:
            missing.append(f"{f}=None")
        elif isinstance(v, str) and v in _FORBIDDEN_VALUES:
            missing.append(f"{f}='{v}'")
    if missing:
        return False, "Missing UI fields: " + ", ".join(missing)
    return True, ""


# ── Normalization: map predicted_* → generic UI names ─────────────────────────
def normalize_ai_prediction_for_ui(ai_raw: dict, strategy_input: dict) -> dict:
    """
    Map strategy_prediction_agent output (predicted_* keys) to the generic
    UI field names used by validate_no_missing_output and render_comparison_columns.
    Pass-through keys: decision, status, source, strategy_input_hash, explanation,
    strategy_factor_scores, rapidapi_context_summary.
    """
    cap = float(strategy_input.get("initial_capital", 100_000))
    return {
        # Core identity
        "status":                 ai_raw.get("status"),
        "source":                 ai_raw.get("source", "strategy_prediction_agent"),
        "decision":               ai_raw.get("decision", "REVIEW"),
        "strategy_input_hash":    ai_raw.get("strategy_input_hash", ""),
        "explanation":            ai_raw.get("explanation", ""),
        "strategy_factor_scores": ai_raw.get("strategy_factor_scores", {}),
        "rapidapi_context_summary": ai_raw.get("rapidapi_context_summary", {}),
        # Normalized financial fields (predicted_* → generic)
        "initial_capital":   float(ai_raw.get("predicted_initial_capital") or cap),
        "final_capital":     ai_raw.get("predicted_final_capital"),
        "total_pl":          ai_raw.get("predicted_total_pl"),
        "total_return_pct":  ai_raw.get("predicted_total_return_pct"),
        "cagr":              ai_raw.get("predicted_cagr"),
        "sharpe":            ai_raw.get("predicted_sharpe"),
        "sortino":           ai_raw.get("predicted_sortino"),
        "max_drawdown":      ai_raw.get("predicted_max_drawdown"),
        "win_rate":          ai_raw.get("predicted_win_rate"),
        "trade_count":       ai_raw.get("predicted_trade_count"),
        "alpha":             ai_raw.get("predicted_alpha"),
        "beta":              ai_raw.get("predicted_beta"),
        "volatility":        ai_raw.get("predicted_volatility"),
