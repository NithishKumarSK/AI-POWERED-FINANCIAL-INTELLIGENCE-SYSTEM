# SECTION 3: Strategy Factor Intelligence Scores
# ══════════════════════════════════════════════════════════════════════════════
def render_factor_scores(ai_pred: dict) -> None:
    _sec("Section 3 · Strategy Factor Intelligence Scores")

    factors = ai_pred.get("strategy_factor_scores", {})
    if not factors:
        st.info("Factor scores not available — run the analysis first.")
        return

    factor_keys = [
        "underlying_regime", "strategy_suitability", "delta_risk", "dte_risk",
        "entry_frequency", "benchmark_regime", "volatility_risk",
        "news_sentiment", "capital_exposure", "strategy_confidence",
    ]

    bars_html = ""
    table_rows = []
    for k in factor_keys:
        f = factors.get(k, {})
        sc  = int(f.get("score", 0))
        sig = f.get("signal", "")
        name= f.get("factor", k.replace("_", " ").title())
        src = f.get("source", "")
        exp = f.get("explanation", "")
        bars_html += _score_bar(name, sc, sig)
        table_rows.append((name, sig, src, exp))

    col1, col2 = st.columns([1, 1])
    with col1:
        st.markdown(bars_html, unsafe_allow_html=True)
    with col2:
        st.dataframe(
            [{"Factor": r[0], "Signal": r[1], "Source": r[2], "Explanation": r[3]}
             for r in table_rows],
            use_container_width=True, hide_index=True)


