        }
        return abbrev.get(v, v)

    cards = [
        ("AI Predicted Decision",     ai_d,        "Source: strategy_prediction_agent"),
        ("Backtest Actual Decision",  bt_d,        "Source: tastytrade (ground truth)"),
        ("Agreement",                 _short(agr), ""),
        ("Final Verified Decision",   _short(final), msg[:80] if msg else ""),
    ]
    html = '<div class="dc-wrap">'
    for lbl, val, sub in cards:
        orig = val.replace("BUY ⚠", "BUY WITH CAUTION").replace("WATCH", "HOLD WITH WATCHLIST").replace("PARTIAL+", "PARTIAL POSITIVE").replace("PARTIAL-", "PARTIAL NEGATIVE")
        css  = _dc_cls(orig)
        html += (f'<div class="dc-card {css}">'
                 f'<div class="dc-lbl">{lbl}</div>'
                 f'<div class="dc-val">{val}</div>'
                 + (f'<div class="dc-sub">{sub}</div>' if sub else "")
                 + '</div>')
    html += '</div>'
    st.markdown(html, unsafe_allow_html=True)

    if msg:
        if agr == "MATCH":                           st.success(f"✓ {msg}")
        elif agr in ("CONFLICT",):                   st.error(f"⚠ {msg}")
        elif agr in ("PARTIAL POSITIVE",):           st.info(f"ℹ {msg}")
        elif agr in ("PARTIAL NEGATIVE", "MISSING"): st.warning(f"⚠ {msg}")
        else:                                         st.warning(f"⚠ {msg}")


